{
    "name": "shopack/yii2-interface-accounting-backend",
    "type": "yii2-extension",
    "authors": [
        {
            "name": "Kambiz Zandi",
            "email": "kambizzandi@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "shopack\\interface\\accounting\\backend\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.45",
        "bizley/jwt": "^3.0",
        "shopack/yii2-base-common": "@dev",
        "shopack/yii2-interface-accounting-common": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "4.8.34"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "path",
            "url": "../common"
        },
        {
            "type": "path",
            "url": "../../yii2-base/common"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}

